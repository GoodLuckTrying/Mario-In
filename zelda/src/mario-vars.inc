; file, room layout and native RAM routine. $7FFF remains the save marker.
M_TTL = $7FC0
M_X = $7FC2
M_Y = $7FC4
M_DIR = $7FC6
M_PHASE = $7FC8
M_FRAC = $7FCA
M_ROOM = $7FCC
M_MODE = $7FCD
M_I = $7FCE
M_STEP = $7FCF
M_COLL = $7FD0
